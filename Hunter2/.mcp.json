{
  "mcpServers": {
    "caido": {
      "command": "tools/bin/caido-mcp-server.exe",
      "args": ["serve"],
      "env": { "CAIDO_URL": "${CAIDO_URL:-http://127.0.0.1:8080}" }
    },
    "burp": {
      "command": "java",
      "args": ["-jar", "${BURP_MCP_JAR}", "--sse-url", "http://127.0.0.1:9876"],
      "env": {}
    },
    "hackerone": {
      "command": "python",
      "args": ["mcp/hackerone-mcp/server.py", "--mcp"],
      "env": {}
    },
    "browser": {
      "command": "npx",
      "args": ["-y", "@playwright/mcp@latest"],
      "env": {}
    },
    "nuclei": {
      "command": "python",
      "args": ["mcp/nuclei-mcp/server.py"],
      "env": {}
    },
    "shodan": {
      "command": "npx",
      "args": ["-y", "@burtthecoder/mcp-shodan"],
      "env": { "SHODAN_API_KEY": "${SHODAN_API_KEY}" }
    }
  }
}
